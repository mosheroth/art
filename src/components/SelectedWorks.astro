---
import { COPY } from '../lib/site';
import { img, url, artworkUrl } from '../lib/paths';
import { heTitle, subjectLabels, type Artwork } from '../lib/artworks';
import { imageSize } from '../lib/imageSize';

interface Props {
  artworks: Artwork[];
}

const { artworks } = Astro.props;
---

<section class="works section" id="works">
  <div class="shell">
    <header class="works-head">
      <div>
        <span class="eyebrow">{COPY.worksEyebrow}</span>
        <h2 class="display-lg">{COPY.worksTitle}</h2>
      </div>
      <div class="works-head-end">
        <p class="lead works-lead">{COPY.worksLead}</p>
        <a href={url('gallery')} class="link-underline">{COPY.worksAll}</a>
      </div>
    </header>

    <div class="works-columns">
      {artworks.map((artwork) => {
        const subjects = subjectLabels(artwork);
        const size = imageSize(artwork.data.image);
        return (
          <figure class="work">
            <a href={artworkUrl(artwork.slug)} class="work-link">
              <span class="work-mat">
                <img
                  src={img(artwork.data.image)}
                  alt={heTitle(artwork)}
                  width={size?.width}
                  height={size?.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <figcaption class="work-caption">
                <span class="work-title">{heTitle(artwork)}</span>
                <span class="work-meta">
                  {[subjects.join(', '), artwork.data.year].filter(Boolean).join(' · ')}
                </span>
              </figcaption>
            </a>
          </figure>
        );
      })}
    </div>
  </div>
</section>

<style>
  .works-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .works-head-end {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .works-lead {
    margin: 0;
    max-width: 42ch;
  }

  .works-columns {
    columns: 2;
    column-gap: clamp(1.5rem, 4vw, 4rem);
  }

  .work {
    break-inside: avoid;
    margin: 0 0 clamp(2rem, 4.5vw, 4rem);
  }

  .work-mat {
    display: block;
    padding: clamp(0.5rem, 1vw, 1rem);
    background: var(--paper-white);
    box-shadow: 0 1px 2px rgba(23, 20, 15, 0.06), 0 20px 40px -32px rgba(23, 20, 15, 0.4);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease;
  }

  .work-mat img {
    width: 100%;
  }

  .work-link:hover .work-mat {
    transform: translateY(-5px);
    box-shadow: 0 1px 2px rgba(23, 20, 15, 0.06), 0 34px 55px -32px rgba(23, 20, 15, 0.5);
  }

  .work-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
    padding-top: 1.1rem;
  }

  .work-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.5vw, 1.5rem);
  }

  .work-link:hover .work-title {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .work-meta {
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: var(--ink-mute);
  }

  @media (max-width: 820px) {
    .works-head {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .works-columns {
      columns: 1;
    }

    .work {
      margin-bottom: 2.75rem;
    }
  }
</style>
