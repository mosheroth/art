---
import { getCollection } from 'astro:content';
import {
  SUBJECT_CATEGORIES,
  filterArtworks,
  getPriceCategory,
  parsePrice,
  type PriceSlug,
  type StatusSlug,
} from '../lib/categories';

type SortSlug = 'price-asc' | 'price-desc' | '';

interface Props {
  price?: PriceSlug;
  status?: StatusSlug;
  sort?: SortSlug;
  limit?: number;
  clientFilter?: boolean;
}

const { price = '', status = '', sort = '', limit, clientFilter = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const basePath = base ? `${base}/` : '/';
const SUBJECT_LABELS = new Map(SUBJECT_CATEGORIES.map((cat) => [cat.slug as string, cat.label as string]));

function shuffleArray<T>(arr: T[]): T[] {
  const out = [...arr];
  for (let i = out.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [out[i], out[j]] = [out[j], out[i]];
  }
  return out;
}

function sortArtworks(artworks: typeof import('astro:content').CollectionEntry<'artworks'>[], order: SortSlug) {
  if (order !== 'price-asc' && order !== 'price-desc') return shuffleArray(artworks);
  return [...artworks].sort((a, b) => {
    const na = a.data.category === 'donation' ? 0 : (parsePrice(a.data.price) ?? -1);
    const nb = b.data.category === 'donation' ? 0 : (parsePrice(b.data.price) ?? -1);
    return order === 'price-desc' ? nb - na : na - nb;
  });
}

let artworks = await getCollection('artworks');
if (!clientFilter) {
  artworks = filterArtworks(artworks, price as PriceSlug, status as StatusSlug);
}

if (limit) {
  artworks = artworks.slice(0, limit);
}

artworks = sortArtworks(artworks, (sort || '') as SortSlug);
---

<div class="grid-wrapper" id="artwork-grid">
<div class="grid">
  {artworks.map((artwork) => {
    const imgSrc = artwork.data.image.startsWith('/')
      ? `${basePath}${artwork.data.image.slice(1)}`
      : `${basePath}${artwork.data.image}`;
    const priceCat = getPriceCategory(artwork.data);
    const priceNum = parsePrice(artwork.data.price);
    const isDonation = artwork.data.category === 'donation';
    const isSold = artwork.data.sold ?? false;
    const subjectSlugs = artwork.data.subjects ?? [];
    const subjects = subjectSlugs.join(',');
    const subjectText = subjectSlugs
      .map((slug) => SUBJECT_LABELS.get(slug))
      .filter(Boolean)
      .join(', ');
    const artworkHref = `${basePath}artwork/${artwork.slug}`;
    return (
      <a
        class="grid-item"
        href={artworkHref}
        data-price-cat={priceCat || undefined}
        data-price={priceNum ?? undefined}
        data-slug={artwork.slug}
        data-donation={isDonation ? 'true' : undefined}
        data-sold={isSold ? 'true' : 'false'}
        data-subjects={subjects || undefined}
      >
        <span class="grid-frame">
          <img src={imgSrc} alt={artwork.data.title} loading="lazy" decoding="async" />
          {isSold && <span class="grid-badge">נמכר</span>}
        </span>
        <span class="grid-caption">
          <span class="grid-title">{artwork.data.titleHe ?? artwork.data.title}</span>
          <span class="grid-meta">
            {subjectText}
          </span>
          {artwork.data.price && <span class="grid-price">{artwork.data.price}</span>}
        </span>
      </a>
    );
  })}
</div>
</div>

<style>
  .grid-wrapper {
    max-width: var(--page);
    margin: 0 auto;
    padding: clamp(1.5rem, 3vw, 2.5rem) var(--gutter) 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.75rem) clamp(1.25rem, 2.5vw, 2rem);
    width: 100%;
  }

  .grid-item {
    display: block;
  }

  .grid-frame {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--paper-deep);
  }

  .grid-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
  }

  .grid-item:hover .grid-frame img {
    transform: scale(1.04);
  }

  .grid-item[data-sold='true'] .grid-frame img {
    filter: saturate(0.75);
  }

  .grid-badge {
    position: absolute;
    inset-inline-start: 0.75rem;
    top: 0.75rem;
    padding: 0.22rem 0.7rem;
    background: rgba(253, 252, 250, 0.92);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  .grid-caption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 1rem;
    padding-top: 0.85rem;
  }

  .grid-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .grid-item:hover .grid-title {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .grid-price {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
  }

  .grid-meta {
    grid-column: 1;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--ink-mute);
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 1rem;
    }

    .grid-title {
      font-size: 1rem;
    }
  }
</style>
