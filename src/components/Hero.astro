---
import { COPY } from '../lib/site';
import { img, url, artworkUrl } from '../lib/paths';
import { heTitle, mediumHe, type Artwork } from '../lib/artworks';
import { imageSize } from '../lib/imageSize';

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
const src = img(artwork.data.image);
const size = imageSize(artwork.data.image);
const meta = [mediumHe(artwork), artwork.data.year].filter(Boolean).join(' · ');
---

<section class="hero">
  <div class="hero-wash" style={`background-image: url('${src}')`} aria-hidden="true"></div>
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="shell hero-inner">
    <figure class="hero-figure">
      <a href={artworkUrl(artwork.slug)} class="hero-frame">
        <img
          src={src}
          alt={heTitle(artwork)}
          width={size?.width}
          height={size?.height}
          fetchpriority="high"
        />
      </a>
      <figcaption class="hero-caption">
        <a href={artworkUrl(artwork.slug)}>
          <span class="hero-caption-title">{heTitle(artwork)}</span>
          {meta && <span class="hero-caption-meta">{meta}</span>}
        </a>
      </figcaption>
    </figure>

    <div class="hero-text">
      <span class="eyebrow">{COPY.heroEyebrow}</span>
      <h1 class="hero-title">
        {COPY.heroTitle.split('\n').map((line, i) => (
          <span class="hero-title-line" style={`--i: ${i}`}>{line}</span>
        ))}
      </h1>
      <p class="lead hero-lead">{COPY.heroLead}</p>
      <div class="hero-actions">
        <a href="#works" class="btn btn-solid">{COPY.heroCtaWorks}</a>
        <a href={url('gallery')} class="link-underline">{COPY.heroCtaSale}</a>
      </div>
    </div>
  </div>

  <a href="#works" class="hero-scroll" aria-label={COPY.heroScroll}>
    <span>{COPY.heroScroll}</span>
    <span class="hero-scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + clamp(1rem, 2.5vw, 2rem));
    padding-bottom: clamp(3.5rem, 7vw, 5.5rem);
    min-height: min(94svh, 940px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* The painting itself becomes the ambient colour of the page */
  .hero-wash {
    position: absolute;
    inset: -20%;
    z-index: -2;
    background-size: cover;
    background-position: center;
    filter: blur(70px) saturate(190%);
    transform: scale(1.1);
    opacity: 0.85;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(130% 100% at 78% 8%, rgba(253, 252, 250, 0.1) 0%, rgba(250, 248, 244, 0.55) 45%, var(--paper) 88%);
  }

  .hero-inner {
    width: 100%;
    max-width: min(1560px, 100%);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .hero-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    animation: rise 1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-frame {
    display: inline-block;
    padding: clamp(0.7rem, 1.4vw, 1.4rem);
    background: var(--paper-white);
    box-shadow:
      0 1px 2px rgba(23, 20, 15, 0.08),
      0 30px 60px -32px rgba(23, 20, 15, 0.45);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease;
  }

  .hero-frame:hover {
    transform: translateY(-4px);
    box-shadow:
      0 1px 2px rgba(23, 20, 15, 0.08),
      0 40px 70px -32px rgba(23, 20, 15, 0.5);
  }

  .hero-frame img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(70svh, 700px);
    object-fit: contain;
  }

  .hero-caption a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.9rem;
  }

  .hero-caption-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .hero-caption-meta {
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }

  .hero-caption a:hover .hero-caption-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.2vw, 4.6rem);
    font-weight: 300;
    line-height: 1.06;
    margin: 0 0 1.5rem;
  }

  .hero-title-line {
    display: block;
    animation: rise 1s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(0.12s + var(--i) * 0.09s);
  }

  .hero-lead {
    max-width: 34ch;
    margin: 0 0 2.25rem;
    animation: rise 1s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    animation: rise 1s cubic-bezier(0.22, 1, 0.36, 1) 0.45s both;
  }

  .hero-scroll {
    position: absolute;
    bottom: clamp(1.25rem, 3vw, 2.5rem);
    inset-inline-start: 50%;
    transform: translateX(50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--ink-mute);
  }

  html[dir='rtl'] .hero-scroll {
    transform: translateX(50%);
  }

  .hero-scroll-line {
    width: 1px;
    height: 44px;
    background: linear-gradient(to bottom, var(--ink-mute), transparent);
    animation: drip 2.4s ease-in-out infinite;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes drip {
    0%,
    100% {
      transform: scaleY(0.5);
      transform-origin: top;
      opacity: 0.4;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
      opacity: 1;
    }
  }

  @media (max-width: 980px) {
    .hero {
      min-height: auto;
      padding-bottom: clamp(3.5rem, 8vw, 6rem);
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: clamp(2rem, 6vw, 3rem);
    }

    .hero-figure {
      align-items: center;
    }

    .hero-frame img {
      max-height: min(52svh, 460px);
    }

    .hero-caption a {
      justify-content: center;
    }

    .hero-title {
      font-size: clamp(2.2rem, 9vw, 3.4rem);
    }

    .hero-lead {
      max-width: 46ch;
    }

    .hero-scroll {
      display: none;
    }
  }
</style>
