---
import { NAV_LINKS, SITE } from '../lib/site';
import { url } from '../lib/paths';

const links = [
  { href: url(''), label: 'בית' },
  ...NAV_LINKS.map((link) => ({
    href: 'query' in link ? `${url(link.path)}?${link.query}` : url(link.path),
    label: link.label,
  })),
  { href: url('gallery'), label: 'כל העבודות' },
];
---

<footer class="footer">
  <div class="shell footer-inner">
    <div class="footer-brand">
      <p class="footer-name">{SITE.name}</p>
      <p class="footer-tagline">{SITE.discipline} · {SITE.location}</p>
      <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" class="footer-handle">
        {SITE.instagramHandle}
      </a>
    </div>

    <nav class="footer-col" aria-label="באתר">
      <p class="footer-col-title">באתר</p>
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="shell footer-base">
    <span>© {new Date().getFullYear()} {SITE.name}</span>
    <span>כל הציורים הם מקור על נייר</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    margin: 0 0 0.35rem;
  }

  .footer-tagline {
    margin: 0 0 0.85rem;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--ink-mute);
  }

  .footer-handle {
    font-size: 0.9rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.1rem;
  }

  .footer-handle:hover {
    border-bottom-color: var(--ink);
  }

  .footer-col-title {
    margin: 0 0 0.85rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--ink-mute);
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-col li + li {
    margin-top: 0.45rem;
  }

  .footer-col a {
    font-size: 0.95rem;
  }

  .footer-col a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }
</style>
