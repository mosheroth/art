---
import { SITE } from '../lib/site';
import { url } from '../lib/paths';

const columns = [
  {
    title: 'באתר',
    links: [
      { href: url(''), label: 'בית' },
      { href: url('gallery'), label: 'עבודות' },
      { href: url('about'), label: 'על האמן' },
    ],
  },
  {
    title: 'רכישה',
    links: [
      { href: `${url('gallery')}?status=available`, label: 'ציורים זמינים' },
      { href: url('passe-partout'), label: 'כלי פספרטו' },
    ],
  },
];
---

<footer class="footer">
  <div class="shell footer-inner">
    <div class="footer-brand">
      <p class="footer-name">{SITE.name}</p>
      <p class="footer-tagline">{SITE.discipline} · {SITE.location}</p>
      <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" class="footer-handle">
        {SITE.instagramHandle}
      </a>
    </div>

    <div class="footer-cols">
      {columns.map((col) => (
        <nav class="footer-col" aria-label={col.title}>
          <p class="footer-col-title">{col.title}</p>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <div class="shell footer-base">
    <span>© {new Date().getFullYear()} {SITE.name}</span>
    <span>כל הציורים הם מקור על נייר</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--paper-deep);
    border-top: 1px solid var(--line-soft);
    padding-block: clamp(3.5rem, 7vw, 6rem) 2rem;
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    font-weight: 300;
    margin: 0 0 0.4rem;
  }

  .footer-tagline {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    color: var(--ink-mute);
  }

  .footer-handle {
    font-size: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.15rem;
    transition: border-color 0.2s ease;
  }

  .footer-handle:hover {
    border-color: var(--ink);
  }

  .footer-cols {
    display: flex;
    flex-wrap: wrap;
    gap: 3.5rem;
  }

  .footer-col-title {
    margin: 0 0 0.9rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--ink-mute);
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .footer-col a {
    font-size: 1rem;
    color: var(--ink-soft);
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: var(--ink);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.85rem;
    color: var(--ink-mute);
  }

  @media (max-width: 640px) {
    .footer-cols {
      gap: 2.5rem;
    }
  }
</style>
