---
import { COPY, HOME_CATEGORIES, SITE } from '../lib/site';
import { url } from '../lib/paths';
---

<section class="intro">
  <div class="shell intro-inner">
    <p class="intro-name">{COPY.introTitle}</p>
    <p class="intro-lead">{COPY.introLead}</p>
    <p class="intro-body">{COPY.introBody}</p>
    <ul class="intro-cats">
      {HOME_CATEGORIES.map((cat) => (
        <li>
          <a href={`#${cat.id}`}>{cat.label}</a>
        </li>
      ))}
    </ul>
    <p class="intro-place">{SITE.discipline} · {SITE.location}</p>
  </div>
</section>

<style>
  .intro {
    padding-block: clamp(4rem, 12vw, 8rem) clamp(3rem, 8vw, 5.5rem);
    border-bottom: 1px solid var(--line);
  }

  .intro-inner {
    max-width: 36rem;
  }

  .intro-name {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 400;
    line-height: 1.05;
    margin: 0 0 0.85rem;
  }

  .intro-lead,
  .intro-body {
    margin: 0;
    font-size: clamp(1.05rem, 0.4vw + 1rem, 1.25rem);
    font-weight: 300;
    color: var(--ink-soft);
  }

  .intro-body {
    margin-top: 0.15rem;
  }

  .intro-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  .intro-cats a {
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.12rem;
  }

  .intro-cats a:hover {
    opacity: 0.55;
  }

  .intro-place {
    margin: 2.5rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    color: var(--ink-mute);
  }
</style>
