---
/**
 * Duotone filter used by the sepia tone.
 * The ramp below is sampled from the artist's own sepia wash paintings
 * (`sepia-seated-figure`, `sepia-reclining-figure`), so colour works mapped
 * through it land on the same paper and ink tones rather than a generic sepia.
 */
---

<svg class="tone-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <filter id="tone-sepia" color-interpolation-filters="sRGB">
    <feColorMatrix type="saturate" values="0" />
    <!-- opens up the tonal range of photographed watercolours before mapping -->
    <feComponentTransfer>
      <feFuncR type="linear" slope="1.45" intercept="-0.18" />
      <feFuncG type="linear" slope="1.45" intercept="-0.18" />
      <feFuncB type="linear" slope="1.45" intercept="-0.18" />
    </feComponentTransfer>
    <feComponentTransfer>
      <feFuncR type="table" tableValues="0.1999 0.3115 0.4178 0.5143 0.6056 0.6942 0.7652 0.8384 0.8858" />
      <feFuncG type="table" tableValues="0.1393 0.2114 0.2957 0.3830 0.4718 0.5630 0.6516 0.7442 0.7952" />
      <feFuncB type="table" tableValues="0.0872 0.1072 0.1500 0.2066 0.2787 0.3692 0.4875 0.6250 0.6933" />
    </feComponentTransfer>
  </filter>
</svg>

<style>
  .tone-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
