---
import { COPY } from '../lib/site';
import { img, url, artworkUrl } from '../lib/paths';
import { heTitle, type Artwork } from '../lib/artworks';
import { imageSize } from '../lib/imageSize';

interface Props {
  id: string;
  label: string;
  lead?: string;
  href: string;
  artworks: Artwork[];
}

const { id, label, lead, href, artworks } = Astro.props;
---

<section class="cat" id={id}>
  <div class="shell">
    <header class="cat-head">
      <div>
        <h2 class="cat-title">{label}</h2>
        {lead && <p class="cat-lead">{lead}</p>}
      </div>
      <a class="cat-all" href={href}>{COPY.categoryAll}</a>
    </header>

    <ul class="cat-list">
      {artworks.map((artwork) => {
        const size = imageSize(artwork.data.image);
        return (
          <li>
            <a class="cat-work" href={artworkUrl(artwork.slug)}>
              <img
                src={img(artwork.data.image)}
                alt={heTitle(artwork)}
                width={size?.width}
                height={size?.height}
                loading="eager"
                decoding="async"
              />
              <span class="cat-caption">
                <span class="cat-name">{heTitle(artwork)}</span>
                {artwork.data.year && <span class="cat-year">{artwork.data.year}</span>}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .cat {
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }

  .cat-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .cat-title {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 400;
  }

  .cat-lead {
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-mute);
  }

  .cat-all {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.15rem;
    flex-shrink: 0;
  }

  .cat-all:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.75rem);
    align-items: end;
  }

  .cat-work {
    display: block;
  }

  .cat-work img {
    width: 100%;
    height: auto;
    background: var(--paper-deep);
  }

  .cat-caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.7rem;
  }

  .cat-name {
    font-size: 0.92rem;
  }

  .cat-work:hover .cat-name {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cat-year {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-mute);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .cat-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
