---
import { COPY } from '../lib/site';
import { img, artworkUrl } from '../lib/paths';
import { heTitle, mediumHe, type Artwork } from '../lib/artworks';

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
const meta = [mediumHe(artwork), artwork.data.year].filter(Boolean).join(' · ');
---

<section class="feature">
  <div class="feature-media">
    <img src={img(artwork.data.image)} alt={heTitle(artwork)} loading="lazy" decoding="async" />
    <div class="feature-scrim" aria-hidden="true"></div>
    <p class="feature-quote">{COPY.featureQuote}</p>
  </div>

  <div class="shell feature-foot">
    <span class="feature-title">{heTitle(artwork)}</span>
    {meta && <span class="feature-meta">{meta}</span>}
    <a href={artworkUrl(artwork.slug)} class="link-underline feature-cta">{COPY.featureLink}</a>
  </div>
</section>

<style>
  .feature {
    margin-block: clamp(1rem, 3vw, 2.5rem);
  }

  .feature-media {
    position: relative;
    height: min(62svh, 620px);
    overflow: hidden;
  }

  .feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .feature-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(23, 20, 15, 0.55) 0%, rgba(23, 20, 15, 0.08) 45%, transparent 75%);
  }

  .feature-quote {
    position: absolute;
    inset-inline: var(--gutter);
    bottom: clamp(1.75rem, 4vw, 3.25rem);
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 3rem);
    font-weight: 300;
    line-height: 1.2;
    color: var(--paper-white);
    text-shadow: 0 1px 24px rgba(23, 20, 15, 0.35);
  }

  .feature-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1.5rem;
    padding-top: 1.25rem;
  }

  .feature-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  .feature-meta {
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: var(--ink-mute);
  }

  .feature-cta {
    margin-inline-start: auto;
  }

  @media (max-width: 720px) {
    .feature-media {
      height: min(56svh, 420px);
    }

    .feature-cta {
      margin-inline-start: 0;
    }
  }
</style>
