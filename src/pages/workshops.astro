---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COPY, SITE } from '../lib/site';
---

<BaseLayout title={`סדנאות | ${SITE.name}`} description={COPY.workshopsEmpty}>
  <article class="workshops">
    <header class="shell workshops-head">
      <h1 class="display-xl">{COPY.workshopsTitle}</h1>
    </header>

    <div class="shell workshops-body">
      <p class="lead">{COPY.workshopsEmpty}</p>
    </div>
  </article>
</BaseLayout>

<style>
  .workshops-head {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .workshops-body {
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }

  .workshops-body .lead {
    margin: 0;
    max-width: 36rem;
  }
</style>
