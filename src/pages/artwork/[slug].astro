---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCategoryLabel } from '../../lib/categories';
import { SITE } from '../../lib/site';
import { mediumHe } from '../../lib/artworks';
import { imageSize } from '../../lib/imageSize';
import { img, url, artworkUrl } from '../../lib/paths';

export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  return artworks.map((artwork) => ({
    params: { slug: artwork.slug },
    props: { artwork, artworks },
  }));
}

const { artwork, artworks } = Astro.props;
const { Content } = await artwork.render();

const title = artwork.data.titleHe ?? artwork.data.title;
const subjectSlugs = Array.isArray(artwork.data.subjects) ? artwork.data.subjects : [];
const imgSrc = img(artwork.data.image);
const roomSrc = img('images/living-room.jpg');
const size = imageSize(artwork.data.image);

const others = artworks
  .filter((entry) => entry.slug !== artwork.slug)
  .filter((entry) => {
    const shared = (entry.data.subjects ?? []).some((slug) => subjectSlugs.includes(slug));
    return shared;
  });
const more = [...others, ...artworks.filter((entry) => entry.slug !== artwork.slug && !others.includes(entry))].slice(0, 4);
---

<BaseLayout
  title={`${title} | ${SITE.name}`}
  description={artwork.data.description ?? `${title} — צבעי מים על נייר מאת ${SITE.name}`}
>
  <article class="artwork">
    <div class="shell artwork-top">
      <a href={url('gallery')} class="back-btn">
        <span class="back-btn-arrow" aria-hidden="true">→</span>
        לכל העבודות
      </a>
    </div>

    <figure class="artwork-stage">
      <div class="stage-wash" style={`background-image: url('${imgSrc}')`} aria-hidden="true"></div>
      <div class="stage-frame" style={size ? `max-width: ${size.width}px` : undefined}>
        <img src={imgSrc} alt={title} width={size?.width} height={size?.height} />
      </div>
      <figcaption class="stage-hint">
        <a href={imgSrc} target="_blank" rel="noopener noreferrer">לצפייה בגודל מלא</a>
      </figcaption>
    </figure>

    <div class="shell artwork-body">
      <div class="artwork-info">
        <h1 class="artwork-title">{title}</h1>

        <p class="artwork-tags">
          {artwork.data.year && <span class="artwork-year">{artwork.data.year}</span>}
          {subjectSlugs.map((slug) => (
            <a href={`${url('gallery')}?subject=${slug}`} class="artwork-tag">{getCategoryLabel(slug)}</a>
          ))}
        </p>

        <div class="artwork-text">
          <Content />
        </div>

        <dl class="artwork-specs">
          {mediumHe(artwork) && (
            <div class="spec">
              <dt>מדיום</dt>
              <dd>{mediumHe(artwork)}</dd>
            </div>
          )}
          {artwork.data.price && (
            <div class="spec">
              <dt>מחיר</dt>
              <dd class="spec-price">{artwork.data.price}</dd>
            </div>
          )}
          {artwork.data.price && (
            <div class="spec">
              <dt>זמינות</dt>
              <dd class={`availability ${artwork.data.sold ? 'sold' : 'available'}`}>
                <span class="availability-dot" aria-hidden="true"></span>
                {artwork.data.sold ? 'נמכר' : 'זמין לרכישה'}
              </dd>
            </div>
          )}
        </dl>

        {artwork.data.price && !artwork.data.sold && (
          <div class="artwork-buy">
            <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" class="btn btn-solid">
              לפנות לגבי הציור
            </a>
            <span class="artwork-buy-note">מקור אחד על נייר · מסירה בהוד השרון והמרכז, או משלוח בתיאום</span>
          </div>
        )}
      </div>

      <aside class="artwork-room">
        <h2 class="room-title">בחלל שלך</h2>
        <div class="room-scene" style={`background-image: url('${roomSrc}')`}>
          <div class="room-frame">
            <img src={imgSrc} alt={`${title} — הדמיה על קיר`} />
          </div>
        </div>
        <p class="room-note">הדמיה להמחשת גודל ביחס לחדר</p>
      </aside>
    </div>

    {more.length > 0 && (
      <section class="shell artwork-more">
        <header class="more-head">
          <h2 class="display-lg">עבודות נוספות</h2>
          <a href={url('gallery')} class="link-underline">לכל העבודות</a>
        </header>
        <ul class="more-list">
          {more.map((entry) => (
            <li>
              <a href={artworkUrl(entry.slug)}>
                <span class="more-image">
                  <img src={img(entry.data.image)} alt={entry.data.titleHe ?? entry.data.title} loading="lazy" />
                </span>
                <span class="more-title">{entry.data.titleHe ?? entry.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .artwork-top {
    padding-top: clamp(1.25rem, 3vw, 2.25rem);
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0;
    font-size: 0.95rem;
    color: var(--ink-mute);
    transition: color 0.2s;
  }

  .back-btn:hover {
    color: var(--ink);
  }

  .back-btn-arrow {
    font-size: 1.1em;
  }

  /* The painting gets the whole stage, with its own colour as the backdrop */
  .artwork-stage {
    position: relative;
    margin: clamp(1rem, 2.5vw, 2rem) 0 0;
    padding: clamp(2rem, 5vw, 4.5rem) var(--gutter) clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    overflow: hidden;
    isolation: isolate;
  }

  .stage-wash {
    position: absolute;
    inset: -20%;
    z-index: -2;
    background-size: cover;
    background-position: center;
    filter: blur(80px) saturate(170%);
    opacity: 0.7;
    mask-image: linear-gradient(to bottom, transparent 12%, #000 34%, #000 62%, transparent 88%);
  }

  .artwork-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(247, 245, 241, 0.6), var(--paper));
  }

  .stage-frame {
    padding: clamp(0.75rem, 1.6vw, 1.6rem);
    max-width: 100%;
    background: var(--paper-white);
    box-shadow:
      0 1px 2px rgba(23, 20, 15, 0.08),
      0 40px 80px -40px rgba(23, 20, 15, 0.5);
  }

  .stage-frame img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(74svh, 760px);
    object-fit: contain;
    vertical-align: top;
  }

  .stage-hint {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }

  .stage-hint a {
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.15rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .stage-hint a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .artwork-body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  .artwork-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 300;
    margin: 0 0 1rem;
  }

  .artwork-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.1rem;
    margin: 0 0 1.75rem;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--ink-mute);
  }

  .artwork-tag {
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.1rem;
    transition: color 0.2s, border-color 0.2s;
  }

  .artwork-tag:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .artwork-text {
    max-width: 58ch;
    color: var(--ink-soft);
  }

  .artwork-text :global(p) {
    margin: 0 0 1rem;
  }

  .artwork-specs {
    margin: 2.25rem 0 0;
    border-top: 1px solid var(--line-soft);
  }

  .spec {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .spec dt {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink-mute);
    padding-top: 0.2rem;
  }

  .spec dd {
    margin: 0;
    font-size: 1.05rem;
  }

  .spec-price {
    font-family: var(--font-display);
    font-size: 1.5rem !important;
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .availability-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .availability.available .availability-dot {
    background: #4a7c59;
  }

  .availability.sold .availability-dot {
    background: #a8503f;
  }

  .artwork-buy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 2rem;
  }

  .artwork-buy-note {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
  }

  .room-title {
    font-size: 0.78rem;
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--ink-mute);
    margin: 0 0 1rem;
  }

  .room-note {
    margin: 0.85rem 0 0;
    font-size: 0.8rem;
    color: var(--ink-mute);
  }

  .room-scene {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    background-size: 200%;
    background-position: center 5%;
    background-repeat: no-repeat;
    overflow: hidden;
    direction: ltr;
  }

  .room-frame {
    position: absolute;
    top: 6%;
    left: 50%;
    transform: translateX(-50%);
    width: 28%;
    max-width: 100%;
    max-height: 75%;
    aspect-ratio: 3/4;
    padding: 0.4rem;
    background: #f5f0e8;
    box-shadow:
      0 1px 4px rgba(0, 0, 0, 0.06),
      inset 0 0 0 1px rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    direction: ltr;
  }

  .room-frame img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  .artwork-more {
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .more-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .more-list {
    list-style: none;
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .more-image {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--paper-deep);
  }

  .more-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .more-list a:hover .more-image img {
    transform: scale(1.05);
  }

  .more-title {
    display: block;
    padding-top: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .more-list a:hover .more-title {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (max-width: 900px) {
    .artwork-body {
      grid-template-columns: 1fr;
    }

    .artwork-room {
      max-width: 520px;
    }

    .stage-hint {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .spec {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }
  }
</style>
