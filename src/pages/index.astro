---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuietIntro from '../components/QuietIntro.astro';
import HomeMix from '../components/HomeMix.astro';
import ContactBand from '../components/ContactBand.astro';
import { HOME_FEATURED_SLUG, HOME_MIX_SLUGS, SITE } from '../lib/site';
import { artworkBySlug, curatedArtworks } from '../lib/artworks';

const featured = await artworkBySlug(HOME_FEATURED_SLUG);
const works = await curatedArtworks(
  [...HOME_MIX_SLUGS],
  HOME_MIX_SLUGS.length,
  featured ? [featured.slug] : []
);
---

<BaseLayout
  title={`${SITE.name} — ציורי צבעי מים`}
  description="ציורי צבעי מים של משה רוט: גוף, עיר ונוף. עבודות מקור על נייר, וגם למכירה."
>
  <QuietIntro artwork={featured} />
  <HomeMix artworks={works} />
  <ContactBand />
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const legacyKeys = ['price', 'status', 'subject', 'sort'];
  if (legacyKeys.some((key) => params.has(key))) {
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    window.location.replace(`${base}/gallery?${params.toString()}`);
  }
</script>
