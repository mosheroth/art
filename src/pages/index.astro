---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuietIntro from '../components/QuietIntro.astro';
import HomeMix from '../components/HomeMix.astro';
import ContactBand from '../components/ContactBand.astro';
import { HOME_MIX_SLUGS, SITE } from '../lib/site';
import { curatedArtworks } from '../lib/artworks';

const works = await curatedArtworks([...HOME_MIX_SLUGS], HOME_MIX_SLUGS.length);
---

<BaseLayout
  title={`${SITE.name} — ציורי צבעי מים`}
  description="ציורי צבעי מים של משה רוט: גוף, תל אביב, נוף. עבודות מקור על נייר, וגם למכירה."
>
  <QuietIntro />
  <HomeMix artworks={works} />
  <ContactBand />
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const legacyKeys = ['price', 'status', 'subject', 'sort'];
  if (legacyKeys.some((key) => params.has(key))) {
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    window.location.replace(`${base}/gallery?${params.toString()}`);
  }
</script>
