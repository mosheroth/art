---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COPY, SITE } from '../lib/site';
import { url } from '../lib/paths';
---

<BaseLayout
  title={`על האמן | ${SITE.name}`}
  description="היי, אני משה רוט, יליד 1985. מצייר צבעי מים, בעיקר בשטח."
>
  <article class="about">
    <header class="shell about-head">
      <div class="about-head-inner">
        <span class="eyebrow">{SITE.discipline}</span>
        <h1 class="display-xl about-title">{COPY.aboutTitle}</h1>
      </div>
    </header>

    <div class="shell about-body">
      <div class="about-text">
        {COPY.aboutBody.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <div class="shell about-cta">
      <a href={url('gallery')} class="btn btn-solid">לכל העבודות</a>
      <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" class="link-underline">
        {SITE.instagramHandle}
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .about-head {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2rem, 4vw, 3rem);
  }

  .about-head-inner {
    max-width: 52ch;
  }

  .about-title {
    max-width: 14ch;
  }

  .about-body {
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }

  .about-text p {
    margin: 0 0 1.4rem;
    max-width: 62ch;
    color: var(--ink-soft);
  }

  .about-text p:last-child {
    margin-bottom: 0;
  }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2.5rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
</style>
