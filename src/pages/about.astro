---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COPY, SITE } from '../lib/site';
import { curatedArtworks, heTitle } from '../lib/artworks';
import { img, url, artworkUrl } from '../lib/paths';

const strip = await curatedArtworks(
  ['sargent-stream-shadow', 'tel-aviv-ibn-gabirol-59', 'sea-after-storm'],
  3
);
---

<BaseLayout
  title={`על האמן | ${SITE.name}`}
  description="היי, אני משה רוט, יליד 1985. גר בהוד השרון, מצייר צבעי מים, בעיקר בשטח."
>
  <article class="about">
    <header class="shell about-head">
      <div class="about-head-inner">
        <span class="eyebrow">{SITE.discipline} · {SITE.location}</span>
        <h1 class="display-xl about-title">{COPY.aboutTitle}</h1>
      </div>
    </header>

    <div class="shell about-body">
      <div class="about-text">
        {COPY.aboutBody.map((paragraph) => <p>{paragraph}</p>)}
        <p class="about-signature">{SITE.name}</p>
      </div>
    </div>

    <ul class="about-strip">
      {strip.map((artwork) => (
        <li>
          <a href={artworkUrl(artwork.slug)}>
            <img src={img(artwork.data.image)} alt={heTitle(artwork)} loading="lazy" />
          </a>
        </li>
      ))}
    </ul>

    <div class="shell about-cta">
      <a href={url('gallery')} class="btn btn-solid">לכל העבודות</a>
      <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" class="link-underline">
        {SITE.instagramHandle}
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .about-head {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2rem, 4vw, 3rem);
  }

  .about-head-inner {
    max-width: 52ch;
  }

  .about-title {
    max-width: 14ch;
  }

  .about-body {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .about-text p {
    margin: 0 0 1.4rem;
    max-width: 62ch;
    color: var(--ink-soft);
  }

  .about-signature {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--ink) !important;
    margin-top: 2rem !important;
  }

  .about-strip {
    list-style: none;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  .about-strip a {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .about-strip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-strip a:hover img {
    transform: scale(1.05);
  }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2.5rem;
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
</style>
